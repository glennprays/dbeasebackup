# =============================================================================
# DBEaseBackup Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# All variables can also be set as environment variables directly

# =============================================================================
# Application Environment
# =============================================================================
# Environment mode: local, development, or production
# In local/development mode, the .env file is loaded automatically
ENV=development

# =============================================================================
# Database Configuration (Required)
# =============================================================================
# PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_password_here
PG_DATABASE=your_database_name

# PostgreSQL SSL mode: disable, require, verify-ca, verify-full
# Use "require" or higher in production for encrypted connections
PG_SSLMODE=disable

# =============================================================================
# Backup Configuration
# =============================================================================
# Backup provider: currently only "postgres" is supported
BACKUP_PROVIDER=postgres

# Local directory for temporary backup files (deleted after upload)
BACKUP_DIR=backups/postgres

# Timeout for backup operations
# Format: Go duration string (e.g., 30m, 1h, 2h30m)
# Increase this for large databases
BACKUP_TIMEOUT=30m

# Backup retention period in days
# Backups older than this will be automatically deleted
# Set to 0 to disable retention (keep all backups indefinitely)
BACKUP_RETENTION_DAYS=30

# Verify backup integrity after upload
# Downloads the backup and runs pg_restore --list to validate structure
# Uses minimal resources (streaming, no disk writes)
BACKUP_VERIFY=true

# =============================================================================
# Scheduler Configuration (Required)
# =============================================================================
# Cron expression for backup schedule
# Examples:
#   "0 * * * *"       - Every hour
#   "0 */6 * * *"     - Every 6 hours
#   "0 2 * * *"       - Daily at 2:00 AM
#   "0 2,14 * * *"    - Twice daily (2am and 2pm)
#   "0 2 * * 0"       - Weekly on Sunday at 2:00 AM
#   "0 2 1 * *"       - Monthly on the 1st at 2:00 AM
CRON_SCHEDULE="0 2 * * *"

# Cron expression for cleanup schedule (optional)
# If not set, cleanup runs on the same schedule as backup
# Recommended: run cleanup at a different time to avoid contention
#CLEANUP_CRON_SCHEDULE="0 3 * * *"

# Timezone for cron job execution
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
SCHEDULER_TIMEZONE=UTC

# =============================================================================
# Storage Configuration
# =============================================================================
# Storage backend type: "google-drive" or "s3"
STORAGE_TYPE=google-drive

# =============================================================================
# Google Drive Storage
# =============================================================================
# Required when STORAGE_TYPE=google-drive

# Google Drive folder ID for storing backups
# Find it in the folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Path to Google Service Account JSON key file
# Download from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_DRIVE_KEY_FILE=service-account-key.json

# =============================================================================
# S3 Storage (Alternative to Google Drive)
# =============================================================================
# Uncomment and configure these when using STORAGE_TYPE=s3

# S3 bucket name for storing backups
#S3_BUCKET=your-backup-bucket

# S3 region
#S3_REGION=us-east-1

# S3 access credentials
#S3_ACCESS_KEY_ID=your_access_key_id
#S3_SECRET_ACCESS_KEY=your_secret_access_key

# Custom S3 endpoint (optional)
# Use for S3-compatible storage (MinIO, DigitalOcean Spaces, etc.)
#S3_ENDPOINT=https://s3-compatible-endpoint.com

# S3 prefix/folder path (optional)
# Organize backups in a specific folder within the bucket
# Example: "backups/postgres" will store files at s3://bucket/backups/postgres/
#S3_PREFIX=backups/postgres

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: debug, info, warn, error
# Use debug for troubleshooting, info for production
LOG_LEVEL=info

# Log format: json or text
# Use json for production (easier to parse), text for development
LOG_FORMAT=text

# =============================================================================
# Webhook Notifications (Optional)
# =============================================================================
# Send HTTP POST notifications after backup operations (success/failure)
# Leave WEBHOOK_URL empty to disable webhook notifications

# Webhook endpoint URL
#WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# HMAC-SHA256 shared secret for webhook signature verification
# Receivers can verify the X-Signature-256 header to authenticate requests
#WEBHOOK_SECRET=your_webhook_secret_here

# Webhook HTTP request timeout
# Format: Go duration string (e.g., 5s, 10s, 30s)
#WEBHOOK_TIMEOUT=10s

# =============================================================================
# Health Check Configuration
# =============================================================================
# HTTP port for health check endpoint (for Kubernetes liveness/readiness probes)
# Set to 0 to disable health server
HTTP_PORT=8080
