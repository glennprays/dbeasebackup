# =============================================================================
# DBEaseBackup Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# All variables can also be set as environment variables directly

# =============================================================================
# Application Environment
# =============================================================================
# Environment mode: local, development, or production
# In local/development mode, the .env file is loaded automatically
ENV=development

# =============================================================================
# Backup Targets (Multi-Target Mode)
# =============================================================================
# Preferred configuration: a YAML/JSON file describing one target per
# database/cluster. Each target has its own connection, schedule, mode
# (logical dump or physical basebackup), retention, and storage placement.
# See targets.example.yaml for the full schema.
#TARGETS_FILE=./targets.yaml

# Maximum number of backup targets dumped concurrently (default: 1)
#MAX_PARALLEL_BACKUPS=1

# =============================================================================
# Legacy Single-Database Fallback
# =============================================================================
# When TARGETS_FILE is unset, one target named "default" is synthesized from
# these legacy PG_* variables (requires PG_HOST, PG_USER, CRON_SCHEDULE).
# These are also the values reused if CLEANUP_CRON_SCHEDULE is unset.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_password_here
PG_DATABASE=your_database_name

# PostgreSQL SSL mode: disable, require, verify-ca, verify-full
PG_SSLMODE=disable

# =============================================================================
# Backup Configuration
# =============================================================================
# Local directory for temporary backup files (deleted after upload)
# Legacy fallback only; per-target backup_dir overrides this
BACKUP_DIR=backups/postgres

# Timeout for backup operations (legacy fallback; per-target timeout overrides)
# Format: Go duration string (e.g., 30m, 1h, 2h30m)
BACKUP_TIMEOUT=30m

# Backup retention period in days (legacy fallback; per-target retention_days
# overrides). Set to 0 to disable retention (keep all backups indefinitely).
BACKUP_RETENTION_DAYS=30

# Verify backup integrity after upload (legacy fallback; per-target verify
# overrides). Dump mode downloads the backup and runs pg_restore --list;
# basebackup mode runs pg_verifybackup before upload.
BACKUP_VERIFY=true

# =============================================================================
# Scheduler Configuration
# =============================================================================
# Cron expression for the legacy-fallback target (required in legacy mode)
# Examples:
#   "0 * * * *"       - Every hour
#   "0 */6 * * *"     - Every 6 hours
#   "0 2 * * *"       - Daily at 2:00 AM
CRON_SCHEDULE="0 2 * * *"

# Cron expression for cleanup (optional)
# - If set: used for all targets' cleanup jobs
# - Legacy mode fallback: CRON_SCHEDULE
# - Multi-target default: "0 3 * * *" (daily at 3 AM)
#CLEANUP_CRON_SCHEDULE="0 3 * * *"

# Timezone for cron job execution
SCHEDULER_TIMEZONE=UTC

# =============================================================================
# Storage Configuration
# =============================================================================
# Storage backend type: "google-drive" or "s3"
# Per-target storage.folder_id / storage.prefix override placement
STORAGE_TYPE=google-drive

# =============================================================================
# Google Drive Storage
# =============================================================================
# Required when STORAGE_TYPE=google-drive

# Google Drive folder ID for storing backups
# Find it in the folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Path to Google Service Account JSON key file
GOOGLE_DRIVE_KEY_FILE=service-account-key.json

# =============================================================================
# S3 Storage (Alternative to Google Drive)
# =============================================================================
# Uncomment and configure these when using STORAGE_TYPE=s3

#S3_BUCKET=your-backup-bucket
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=your_access_key_id
#S3_SECRET_ACCESS_KEY=your_secret_access_key
# Custom S3 endpoint (MinIO, DigitalOcean Spaces, etc.)
#S3_ENDPOINT=https://s3-compatible-endpoint.com
# S3 prefix/folder path for all uploads (per-target prefix nests inside)
#S3_PREFIX=backups/postgres

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json or text
LOG_FORMAT=text

# =============================================================================
# Webhook Notifications (Optional)
# =============================================================================
# Send HTTP POST notifications after backup operations (success/failure)
# Every event carries a "target" field identifying the backup target.

#WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
#WEBHOOK_SECRET=your_webhook_secret_here
#WEBHOOK_TIMEOUT=10s

# =============================================================================
# Health Check Configuration
# =============================================================================
# HTTP port for health endpoints (Kubernetes probes)
# /health and /readyz gate on storage health; per-target last-run status is
# reported in the response body ("targets" array).
# Set to 0 to disable health server
HTTP_PORT=8080
